rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly granted below
    match /{document=**} {
      allow read, write: if false;
    }

    // Categories: public read, no client write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Produits: public read only if actif == true, no client write
    match /produits/{produitId} {
      allow get: if resource.data.actif == true;
      allow list: if resource.data.actif == true;
      allow write: if false;
    }

    // Packs: public read only if actif == true, no client write
    match /packs/{packId} {
      allow get: if resource.data.actif == true;
      allow list: if resource.data.actif == true;
      allow write: if false;
    }

    // Avis: public read only if valide == true, no client write
    match /avis/{aviId} {
      allow get: if resource.data.valide == true;
      allow list: if resource.data.valide == true;
      allow write: if false;
    }

    // Config: public read (e.g. config/site), no client write
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders, B2B quotes, and Newsletter: strictly managed server-side
    match /commandes/{commandeId} {
      allow read, write: if false;
    }

    match /demandesPro/{demandeId} {
      allow read, write: if false;
    }

    match /newsletter/{subscriberId} {
      allow read, write: if false;
    }
  }
}
